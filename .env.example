# =================================================================
# AI-Assisted Career Guidance System — Environment Configuration
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication Secrets
JWT_SECRET=your_super_secret_production_jwt_signing_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# Database Configuration (MySQL Support)
# If MySQL is running and configured, the system connects automatically.
# If MySQL is inactive, the system seamlessly falls back to the embedded zero-config SQLite Wasm database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=career_guidance_system

# Gemini AI Integration (Optional)
# If provided, powers live LLM reasoning for the Career Advisor chatbot and recommendation explanations.
# If left blank, the built-in deterministic heuristic AI engine will operate automatically.
GEMINI_API_KEY=
